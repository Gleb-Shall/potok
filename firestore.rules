rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/workspaces/main {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function validWorkspace() {
        let data = request.resource.data;
        return data.keys().hasAll(['version', 'revision', 'payload', 'updatedAt'])
          && data.keys().hasOnly(['version', 'revision', 'payload', 'updatedAt'])
          && data.version == 2 && data.revision is int
          && data.payload is string && data.payload.size() <= 900000
          && data.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && validWorkspace() && request.resource.data.revision == 1;
      allow update: if owner() && validWorkspace() && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
