rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function validInterval(data) {
      return data.start is int && data.duration is int
        && data.start >= 0 && data.duration >= 5 && data.start + data.duration <= 1440;
    }
    function validStudent(data) {
      return data.keys().hasAll(['name', 'subject', 'rate', 'contact', 'notes', 'color'])
        && data.keys().hasOnly(['name', 'subject', 'rate', 'contact', 'notes', 'color'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.subject is string && data.subject.size() <= 100
        && data.contact is string && data.contact.size() <= 500
        && data.notes is string && data.notes.size() <= 5000
        && data.rate is number && data.rate >= 0 && data.rate <= 1000000
        && data.color in ['violet', 'blue', 'green', 'peach', 'pink'];
    }
    function validSeries(data, uid) {
      return data.keys().hasAll(['studentId', 'from', 'until', 'weekday', 'start', 'duration', 'notes'])
        && data.keys().hasOnly(['studentId', 'from', 'until', 'weekday', 'start', 'duration', 'notes'])
        && data.studentId is string
        && exists(/databases/$(database)/documents/users/$(uid)/students/$(data.studentId))
        && validDate(data.from) && (data.until == '' || (validDate(data.until) && data.until >= data.from))
        && data.weekday is int && data.weekday >= 0 && data.weekday <= 6
        && validInterval(data) && data.notes is string && data.notes.size() <= 5000;
    }
    function validLesson(data, uid) {
      return data.keys().hasAll(['studentId', 'seriesId', 'anchorDate', 'date', 'start', 'duration', 'status', 'notes', 'history'])
        && data.keys().hasOnly(['studentId', 'seriesId', 'anchorDate', 'date', 'start', 'duration', 'status', 'notes', 'history', 'originalDate', 'originalStart', 'originalDuration'])
        && data.studentId is string
        && exists(/databases/$(database)/documents/users/$(uid)/students/$(data.studentId))
        && data.seriesId is string && validDate(data.anchorDate)
        && (validDate(data.date) || (data.date == null && data.status == 'pending'))
        && validInterval(data) && data.status in ['planned', 'done', 'cancelled', 'pending']
        && data.notes is string && data.notes.size() <= 5000
        && data.history is list && data.history.size() <= 200;
    }
    match /users/{uid}/students/{id} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validStudent(request.resource.data);
    }
    match /users/{uid}/series/{id} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validSeries(request.resource.data, uid);
    }
    match /users/{uid}/lessons/{id} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validLesson(request.resource.data, uid);
    }
  }
}
