# Optional Apple Maps: create a domain-restricted browser Maps Token, not a private key.
# https://developer.apple.com/documentation/mapkitjs/creating-a-maps-token
# Put the actual token in .env.local (ignored by git).
VITE_APPLE_MAPS_TOKEN=
# Available: apple / maplibre. The interface can switch between both maps.
VITE_MAP_PROVIDER=maplibre
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_SEARCH_URL=https://photon.komoot.io/api/
